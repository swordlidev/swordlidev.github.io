---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts, groupByTag } from '../../utils/posts';

const tags = groupByTag(await getPublishedPosts());
---

<BaseLayout title="Tags" description="Browse posts by tag.">
  <header class="page-header">
    <h1>Tags</h1>
    <p>{tags.length} tags</p>
  </header>

  {
    tags.length > 0 ? (
      <ul class="tag-list tag-cloud">
        {tags.map((t) => (
          <li>
            <a class="tag" href={`/tags/${t.slug}/`}>
              #{t.name}
              <span class="tag-count">{t.posts.length}</span>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="empty">No tags yet.</p>
    )
  }
</BaseLayout>
