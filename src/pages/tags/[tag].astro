---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostItem from '../../components/PostItem.astro';
import { getPublishedPosts, groupByTag, type Post } from '../../utils/posts';

export async function getStaticPaths() {
  const tags = groupByTag(await getPublishedPosts());
  return tags.map((t) => ({
    params: { tag: t.slug },
    props: { name: t.name, posts: t.posts },
  }));
}

interface Props {
  name: string;
  posts: Post[];
}

const { name, posts } = Astro.props;
---

<BaseLayout title={`Tag: ${name}`} description={`All posts tagged "${name}".`}>
  <header class="page-header">
    <h1>#{name}</h1>
    <p>{posts.length} posts &middot; <a href="/tags/">All tags</a></p>
  </header>

  <ul class="post-list">
    {posts.map((post) => <PostItem post={post} />)}
  </ul>
</BaseLayout>
