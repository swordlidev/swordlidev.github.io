---
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { PROFILE, RESEARCH_INTERESTS, SCHOLAR, TIMELINE, NEWS } from '../consts';
---

<BaseLayout title="About" description={`About ${PROFILE.name}`}>
  <header class="page-header">
    <h1>About</h1>
    <p>{PROFILE.title} @ {PROFILE.affiliation}</p>
  </header>

  <section class="section prose">
    <p>
      I am <strong>{PROFILE.name} ({PROFILE.nameCn})</strong>, a researcher at {PROFILE.affiliation}, based in {PROFILE.location}.
      My current research centers on large language models (LLMs), multimodal LLMs (MLLMs), agents, and reinforcement
      learning (RL) — in particular, how models can understand multimodal information more efficiently, retrieve and
      reason more reliably, and act autonomously in complex tasks.
    </p>
    <p>
      Before moving into the large-model space, I spent several years in computer vision, with representative work on
      face detection (<a href="https://arxiv.org/abs/1810.10220" target="_blank" rel="noopener noreferrer">DSFD</a>, ASFD),
      temporal action detection (DBG), and efficient network architectures (EMO).
    </p>
  </section>

  <section class="section">
    <div class="section-header"><h2>Research Interests</h2></div>
    <ul class="tag-list tag-cloud">
      {RESEARCH_INTERESTS.map((r) => <li><span class="tag">{r}</span></li>)}
    </ul>
  </section>

  <section class="section">
    <div class="section-header"><h2>Experience</h2></div>
    <ul class="news-list timeline">
      {
        TIMELINE.map((t) => (
          <li>
            <time>{t.date}</time>
            <span set:html={t.html} />
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section">
    <div class="section-header"><h2>News</h2></div>
    <ul class="news-list">
      {
        NEWS.map((n) => (
          <li>
            <time>{n.date}</time>
            <span set:html={n.html} />
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section prose">
    <h2>Current Topics</h2>
    <ul>
      <li><strong>Search &amp; RAG agents</strong>: self-evolving search agents (SE-Search), retrieval-augmented generation (Disco-RAG), AI Search survey.</li>
      <li><strong>Multimodal understanding &amp; evaluation</strong>: MLLM benchmarks (MMAD, MLLM Benchmarks survey), video moment retrieval (LLaVA-MR).</li>
      <li><strong>RL &amp; alignment</strong>: efficient policy optimization for LLMs (TGPO), reward modeling, role-playing agents.</li>
      <li><strong>Efficiency &amp; distillation</strong>: efficient MLLM survey, dataset distillation, knowledge distillation.</li>
    </ul>
  </section>

  <section class="section prose">
    <h2>Metrics</h2>
    <p>
      As of now: ~{SCHOLAR.citations} citations, h-index {SCHOLAR.hIndex}, i10-index {SCHOLAR.i10Index}
      (from <a href={SCHOLAR.profile} target="_blank" rel="noopener noreferrer">Google Scholar</a>; values change over time).
    </p>
  </section>

  <section class="section">
    <div class="section-header"><h2>Contact</h2></div>
    <p>Feel free to reach out about research collaboration, discussion, or internship opportunities: <a href={`mailto:${PROFILE.email}`}>{PROFILE.email}</a></p>
    <SocialLinks />
  </section>
</BaseLayout>
