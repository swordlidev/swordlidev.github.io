---
import BaseLayout from '../layouts/BaseLayout.astro';
import PubItem from '../components/PubItem.astro';
import { PUBLICATIONS, type Publication } from '../data/publications';
import { SCHOLAR } from '../consts';

const sorted = [...PUBLICATIONS].sort((a, b) => b.year - a.year);
const groups = new Map<number, Publication[]>();
for (const p of sorted) {
  const list = groups.get(p.year) ?? [];
  list.push(p);
  groups.set(p.year, list);
}
---

<BaseLayout title="Publications" description="Publications by Jian Li on LLM, MLLM, Agent, RL and more.">
  <header class="page-header">
    <h1>Publications</h1>
    <p>
      {PUBLICATIONS.length} selected papers, focused on the last 3 years &middot;
      <a href={SCHOLAR.profile} target="_blank" rel="noopener noreferrer">Full list on Google Scholar &rarr;</a>
    </p>
    <p class="pub-hint">
      <span class="legend"><span class="dot dot-first"></span>Bold indicates my name</span>
    </p>
  </header>

  {
    [...groups].map(([year, list]) => (
      <section class="year-group">
        <h2 class="year-title">{year}</h2>
        <ol class="pub-list">
          {list.map((pub) => (
            <PubItem pub={pub} />
          ))}
        </ol>
      </section>
    ))
  }
</BaseLayout>
